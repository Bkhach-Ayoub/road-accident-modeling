library(tidyr)
library(dplyr)
# La seule colonne existante
col_unique <- names(df)[1]
# Séparer la colonne en 45 colonnes (ONISR a 45 variables)
# Si tu ne connais pas exactement le nombre, on peut détecter automatiquement
df_clean <- df %>%
separate(
col = all_of(col_unique),
into = paste0("var", 1:50),     # on crée 50 colonnes au cas où
sep = ",",
fill = "right",
remove = TRUE
)
# Affichage pour vérifier
str(df_clean)
head(df_clean)
