###############################################
# K-means sur les accidents ONISR-2019
###############################################
# 1. Chargement du jeu de données
# (adapter le chemin du fichier si besoin)
df <- read.csv2("ONISR-2019.csv", stringsAsFactors = FALSE)
# 2. Sélection des variables pour le clustering
#    (ici des variables de contexte codées en numérique)
vars_kmeans <- c(
"lum",    # luminosité
"agg",    # agglomération
"atm",    # conditions atmosphériques
"col",    # type de collision
"circ",   # régime de circulation
"surf",   # état de la surface
"plan",   # profil en plan
"vosp",   # voie spéciale
"prof",   # profil en long
"pr",     # point de repère
"pr1"     # complément du PR
)
# garder uniquement les colonnes qui existent vraiment (sécurité)
vars_kmeans <- intersect(vars_kmeans, colnames(df))
X <- df[ , vars_kmeans]
# 3. Nettoyage : suppression des lignes avec NA
X <- na.omit(X)
# 4. Conversion explicite en numérique (au cas où ce sont des factors/char)
X[] <- lapply(X, function(col) as.numeric(col))
# 5. Normalisation des variables (indispensable pour k-means)
X_scaled <- scale(X)
# 6. Méthode du coude pour aider à choisir le nombre de clusters k
set.seed(123)
max_k <- 10
wss <- numeric(max_k)
for (k in 1:max_k) {
km_tmp <- kmeans(X_scaled, centers = k, nstart = 20)
wss[k] <- km_tmp$tot.withinss
}
###############################################
# K-means sur les accidents ONISR-2019
###############################################
## 1. Chargement du jeu de données
df <- read.csv2("ONISR-2019.csv", stringsAsFactors = FALSE)
## 2. Sélection des variables pour le clustering
vars_kmeans <- c(
"lum",    # luminosité
"agg",    # agglomération
"atm",    # conditions atmosphériques
"col",    # type de collision
"circ",   # régime de circulation
"surf",   # état de la surface
"plan",   # profil en plan
"vosp",   # voie spéciale
"prof",   # profil en long
"pr",     # point de repère
"pr1"     # complément du PR
)
# On ne garde que les colonnes qui existent réellement
vars_kmeans <- intersect(vars_kmeans, colnames(df))
X <- df[ , vars_kmeans]
## 3. Nettoyage : suppression des lignes avec NA
X <- na.omit(X)
# Sauvegarde de l’index des lignes pour reconstruire df_clean ensuite
idx_lignes <- as.numeric(rownames(X))
## 4. Conversion explicite en numérique (au cas où ce sont des factors/char)
X[] <- lapply(X, function(col) as.numeric(col))
## 5. Normalisation des variables
X_scaled <- scale(X)
## 6. Calcul du nombre de points DISTINCTS
n_distinct <- nrow(unique(X_scaled))
if (n_distinct < 2) {
stop("Trop peu de points distincts pour faire un k-means.")
}
```{r kmeans_accidents}
# ===================================================
# Regroupement des accidents en clusters (k-means)
# ===================================================
# On choisit quelques variables numériques pertinentes pour le clustering.
# Ici : le score de sévérité et les nombres de véhicules impliqués.
vars_kmeans <- c("S_sevérité", "nb_voiture", "nb_camion", "nb_transport")
# On ne garde que celles qui existent réellement dans df
vars_kmeans <- intersect(vars_kmeans, colnames(df))
# Si aucune variable valable -> on stoppe avec un message clair
if (length(vars_kmeans) < 2) {
stop("Pas assez de variables numériques trouvées dans df pour faire un k-means.")
}
```{r kmeans_auto}
# ======================================================
# K-means automatique sur toutes les colonnes numériques
# (solution robuste pour données ONISR)
# ======================================================
df_raw <- df   # sauvegarde
# 1. Convertir toutes les colonnes en numériques (si possible)
df_num <- as.data.frame(lapply(df_raw, function(col) {
suppressWarnings(as.numeric(col))  # texte -> NA
}))
# 2. Garder uniquement les colonnes avec au moins 2 valeurs distinctes
cols_valides <- sapply(df_num, function(col) {
length(unique(na.omit(col))) >= 2
})
df_num <- df_num[, cols_valides, drop = FALSE]
if (ncol(df_num) < 2) {
stop("Aucune variable numérique exploitable trouvée, même après conversion.")
}
