# =========================
# 1. Librairies
# =========================
library(dplyr)
library(ggplot2)
library(sf)
library(geodata)
install.packages("geodata")
# =========================
# 1. Librairies
# =========================
library(dplyr)
library(ggplot2)
library(sf)
library(geodata)
# =========================
# 2. Charger la carte des départements français
# (niveau 2 = départements)
# =========================
fr_dep <- gadm(
country = "FRA",
level = 2,
path = tempdir()
)
# =========================
# 3. Préparer les codes département
# =========================
table_frequence <- table_frequence %>%
mutate(
dep = as.character(dep),
dep = ifelse(nchar(dep) == 1, paste0("0", dep), dep)
)
# Dans GADM, le code département est dans NAME_2
# Exemple : "Paris", "Nord", etc.
# On utilise CC_2 quand disponible, sinon on reconstruit
# =========================
# 4. Créer une table de correspondance
# =========================
dep_ref <- data.frame(
dep = c(sprintf("%02d", 1:95), "2A", "2B"),
stringsAsFactors = FALSE
)
dep_ref$NAME_2 <- c(
unique(fr_dep$NAME_2)[1:length(dep_ref$dep)]
)
# =========================
# 5. Jointure carte ↔ données
# =========================
fr_dep_freq <- fr_dep %>%
left_join(
table_frequence,
by = c("NAME_2" = "dep")
) %>%
mutate(freq_1000 = 1000 * frequence_par_conducteur)
