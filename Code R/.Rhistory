library(dplyr)
library(ggplot2)
library(sf)
library(giscoR)
# =========================
# 1. Charger la carte des départements (NUTS 3)
# =========================
fr_dep <- gisco_get_nuts(
country = "FR",
nuts_level = 3,
year = 2016,
resolution = "20"
)
# =========================
# 2. Préparer la table de fréquence
# (CORRECTION CLÉ ICI)
# =========================
table_frequence <- table_frequence %>%
mutate(
dep = as.character(dep),
dep = gsub("^FR", "", dep),   # enlève un éventuel "FR" déjà présent
NUTS_ID = case_when(
dep == "2A" ~ "FRM",
dep == "2B" ~ "FRL",
TRUE        ~ paste0("FR", dep)
)
)
# =========================
# 3. Jointure carte ↔ données
# =========================
fr_dep_freq <- fr_dep %>%
left_join(table_frequence, by = "NUTS_ID") %>%
mutate(freq_1000 = 1000 * frequence_par_conducteur)
# =========================
# 4. Tracé de la carte
# =========================
ggplot(fr_dep_freq) +
geom_sf(
aes(fill = freq_1000),
color = "white",
linewidth = 0.15
) +
scale_fill_viridis_c(
option = "plasma",
na.value = "grey90",
name = "Accidents\npour 1000 conducteurs"
) +
coord_sf(
xlim = c(-5.5, 9.5),
ylim = c(41, 51.5),
expand = FALSE
) +
labs(
title = "Fréquence des accidents par conducteur en France (2019)",
subtitle = "Représentation par département",
caption = "Source : ONISR 2019 – giscoR"
) +
theme_minimal()
