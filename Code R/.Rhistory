summarise(
n                = n(),
lum_dominante    = names(which.max(table(lum2))),
atm_dominante    = names(which.max(table(atm3))),
col_dominante    = names(which.max(table(col3))),
situ_dominante   = names(which.max(table(situ2))),
vma_dominante    = names(which.max(table(vma3))),
nb_voiture_moy   = mean(nb_voiture,   na.rm = TRUE),
nb_moto_moy      = mean(nb_moto,      na.rm = TRUE),
nb_velo_moy      = mean(nb_velo,      na.rm = TRUE),
nb_camion_moy    = mean(nb_camion,    na.rm = TRUE),
nb_transport_moy = mean(nb_transport, na.rm = TRUE)
)
View(resume_clusters)
## ============================
## 1) Sélection des variables utiles
## ============================
vars <- c("lum","atm","agg","catr","circ","col","surf","infra","situ",
"nb_voiture","nb_moto","nb_velo","nb_camion","nb_transport")
df_sub <- df[, vars]
## ============================
## 2) Encodage des facteurs en variables numériques
## ============================
X <- model.matrix(~ ., data = df_sub)[ , -1]   # -1 pour enlever l'intercept
## ============================
## 3) Filtrer uniquement les lignes complètes
## ============================
idx_comp <- complete.cases(X)
X_comp <- X[idx_comp, ]
## ============================
## 4) Standardisation
## ============================
X_scaled <- scale(X_comp)
## ============================
## 5) Choix du nombre optimal de clusters (méthode du coude)
## ============================
wss <- sapply(1:10, function(k){
kmeans(X_scaled, centers = k, nstart = 20)$tot.withinss
})
plot(1:10, wss, type="b",
xlab="k (nombre de clusters)",
ylab="Inertie intra-classe (WSS)",
main="Méthode du coude")
## ============================
## 6) K-means avec k = 3
## ============================
k <- 3
set.seed(123)
km <- kmeans(X_scaled, centers = k, nstart = 50)
## ============================
## 7) Ajouter les clusters dans df
## ============================
df$cluster <- NA
df$cluster[idx_comp] <- km$cluster
df$cluster <- factor(df$cluster)
## ============================
## 8) Résumé des clusters
## ============================
library(dplyr)
resume_clusters <- df[idx_comp, ] %>%
group_by(cluster) %>%
summarise(
n = n(),
lum_dominante  = names(which.max(table(lum))),
atm_dominante  = names(which.max(table(atm))),
col_dominante  = names(which.max(table(col))),
situ_dom       = names(which.max(table(situ))),
v_moy_voiture  = mean(nb_voiture, na.rm = TRUE),
v_moy_moto     = mean(nb_moto, na.rm = TRUE),
v_moy_velo     = mean(nb_velo, na.rm = TRUE),
v_moy_camion   = mean(nb_camion, na.rm = TRUE),
v_moy_transport= mean(nb_transport, na.rm = TRUE)
)
resume_clusters
## ============================
## 1) ACP sur X_scaled
## ============================
acp <- prcomp(X_scaled, center = FALSE, scale. = FALSE)
# Coordonnées des individus (axes 1 et 2)
coord <- acp$x[, 1:2]
# Centres des clusters dans le plan ACP
centres_acp <- aggregate(coord,
by = list(cluster = km$cluster),
FUN = mean)
coord1 <- acp$x[,1]   # axe 1
coord2 <- acp$x[,2]   # axe 2
## ============================
## 2) Couleurs pour les clusters
## ============================
colors <- c("red", "blue", "darkgreen", "purple",
"orange", "brown", "pink", "gray")
## ============================
## 3) Graphe final des groupes
## ============================
plot(coord1, coord2,
col = colors[km$cluster],
pch = 19,
cex = 0.6,
xlab = "Axe 1 (ACP)",
ylab = "Axe 2 (ACP)",
main = paste("Répartition des", length(unique(km$cluster)),
"clusters (ACP + k-means)")
)
# Ajout des centres des clusters
points(centres_acp$PC1, centres_acp$PC2,
pch = 19, cex = 2, lwd = 2, col = "black")
legend("topright",
legend = c(paste("Cluster", 1:k), "Centre"),
col    = c(colors[1:k], "black"),
pch    = c(rep(19, k), 19),
cex    = 0.6)
library(dplyr)
vars <- c("lum2","atm3","surf","col3","situ2","vma3",
"nb_voiture","nb_moto","nb_velo","nb_camion","nb_transport",
"S_sevérité")
df_sub <- df[, vars]
# Encodage dummies + suppression des NA
X <- model.matrix(~ ., data = df_sub)[ , -1]
idx_comp <- complete.cases(X)
X_scaled <- scale(X[idx_comp, ])
# K-means
set.seed(123)
km <- kmeans(X_scaled, centers = 3, nstart = 50)
# ACP pour affichage
acp <- prcomp(X_scaled, scale. = FALSE, center = FALSE)
# Coordonnées des individus (axes 1 et 2)
coord <- acp$x[, 1:2]
# Centres des clusters dans le plan ACP
centres_acp <- aggregate(coord,
by = list(cluster = km$cluster),
FUN = mean)
plot(acp$x[,1], acp$x[,2],
col = c("red","blue","darkgreen","purple")[km$cluster],
pch = 19, cex = 0.6,
xlab = "Axe 1 (ACP)", ylab = "Axe 2 (ACP)",
main = "Clusters incluant la sévérité")
# Ajout des centres des clusters
points(centres_acp$PC1, centres_acp$PC2,
pch = 19, cex = 2, lwd = 2, col = "black")
legend("topright",
legend = c(paste("Cluster", 1:k), "Centre"),
col    = c(colors[1:k], "black"),
pch    = c(rep(19, k), 19),
cex    = 0.6)
resume_clusters_avec_severite <- df_comp %>%
group_by(cluster) %>%
summarise(
n = n(),
# Modalités dominantes (qualitatives)
lum_dominante  = names(which.max(table(lum2))),
atm_dominante  = names(which.max(table(atm3))),
col_dominante  = names(which.max(table(col3))),
situ_dominante = names(which.max(table(situ2))),
vma_dominante  = names(which.max(table(vma3))),
# Moyennes des véhicules
nb_voiture_moy   = mean(nb_voiture,   na.rm = TRUE),
nb_moto_moy      = mean(nb_moto,      na.rm = TRUE),
nb_velo_moy      = mean(nb_velo,      na.rm = TRUE),
nb_camion_moy    = mean(nb_camion,    na.rm = TRUE),
nb_transport_moy = mean(nb_transport, na.rm = TRUE),
# 🔹 Sévérité (AJOUT CLÉ)
severite_moy = mean(S_sevérité, na.rm = TRUE),
severite_sd  = sd(S_sevérité,   na.rm = TRUE)
)
resume_clusters_avec_severite
accidents_par_mois <- df %>%
group_by(mois) %>%
summarise(nb_accidents = n()) %>%
arrange(mois)
accidents_par_mois
plot(accidents_par_mois$mois, accidents_par_mois$nb_accidents,
type = "b", pch = 19,
xlab = "Mois (2019)",
ylab = "Nombre d'accidents",
main = "Nombre d'accidents par mois en France (2019)")
library(dplyr)
tab_accidents <- df %>%
mutate(dep = as.character(dep)) %>%
filter(!is.na(dep), dep != "") %>%
group_by(dep) %>%
summarise(nb_accidents = n(), .groups = "drop")
tab_conducteurs <- df_premium %>%
mutate(dep = as.character(dep),
nb_cond = as.numeric(nb.cond)) %>%
filter(!is.na(dep), dep != "", !is.na(nb_cond)) %>%
group_by(dep) %>%
summarise(nb_conducteurs = sum(nb_cond), .groups = "drop")
table_frequence <- tab_accidents %>%
left_join(tab_conducteurs, by = "dep") %>%
filter(!is.na(nb_conducteurs), nb_conducteurs > 0) %>%
mutate(
frequence_par_conducteur = nb_accidents / (nb_conducteurs/nb_accidents)
) %>%
arrange(desc(frequence_par_conducteur))
table_frequence$nb_conducteurs = (table_frequence$nb_conducteurs / table_frequence$nb_accidents)
table_frequence$frequence_par_1000conducteur = table_frequence$frequence_par_conducteur * 1000
View(table_frequence)
top7 <- table_frequence %>%
arrange(desc(frequence_par_conducteur)) %>%
slice_head(n = 7)
barplot(1000 * top7$frequence_par_conducteur,
names.arg = top7$dep,
las = 2,
ylab = "Fréquence par 1000 conducteur",
xlab = "département",
main = "Top 7 des départements par fréquence d'accidents (2019)")
library(dplyr)
df_75 <- df %>%
mutate(dep = as.character(dep)) %>%
filter(dep == "75")
df_75_mois <- df_75 %>%
mutate(mois = as.integer(mois)) %>%
group_by(mois) %>%
summarise(
nb_accidents = n(),
prop_nuit = mean(lum2 == "Sans_lumiere", na.rm = TRUE),
prop_meteo_def = mean(atm3 %in% c("Défavorable", "Sévère"), na.rm = TRUE),
prop_vma80 = mean(vma3 == "80_plus", na.rm = TRUE),
prop_hors_circ = mean(situ2 == "Hors_circulation", na.rm = TRUE),
prop_routes_princ = mean(catr3 == "Routes_significatives", na.rm = TRUE),
.groups = "drop"
)
mod_quasi_75 <- glm(
nb_accidents ~ prop_nuit + prop_meteo_def + prop_hors_circ + prop_routes_princ + prop_vma80,
family = quasipoisson(link = "log"),
data = df_75_mois
)
summary(mod_quasi_75)
dispersion_75 <- sum(residuals(mod_quasi_75, type = "pearson")^2) /
df.residual(mod_quasi_75)
dispersion_75
exp(coef(mod_quasi_75))
df_90 <- df %>%
mutate(dep = as.character(dep)) %>%
filter(dep == "90")
df_90_mois <- df_90 %>%
mutate(mois = as.integer(mois)) %>%
group_by(mois) %>%
summarise(
nb_accidents = n(),
prop_nuit = mean(lum2 == "Sans_lumiere", na.rm = TRUE),
prop_meteo_def = mean(atm3 %in% c("Défavorable", "Sévère"), na.rm = TRUE),
prop_vma80 = mean(vma3 == "80_plus", na.rm = TRUE),
prop_hors_circ = mean(situ2 == "Hors_circulation", na.rm = TRUE),
prop_routes_princ = mean(catr3 == "Routes_significatives", na.rm = TRUE),
.groups = "drop"
)
mod_quasi_90 <- glm(
nb_accidents ~ prop_nuit + prop_meteo_def + prop_hors_circ + prop_routes_princ + prop_vma80,
family = quasipoisson(link = "log"),
data = df_90_mois
)
summary(mod_quasi_90)
dispersion_90 <- sum(residuals(mod_quasi_90, type = "pearson")^2) /
df.residual(mod_quasi_90)
dispersion_90
exp(coef(mod_quasi_90))
# ------------------------------------------------------------
# INSTALLATION
# ------------------------------------------------------------
# install.packages("ggplot2")
# install.packages("sf")          # indispensable maintenant
# install.packages("dplyr")
# install.packages("viridis")
# ------------------------------------------------------------
# CHARGEMENT DES LIBRAIRIES
# ------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(sf)
library(viridis)
# ------------------------------------------------------------
# 1. TÉLÉCHARGER ET PRÉPARER LES DONNÉES GÉOGRAPHIQUES
# ------------------------------------------------------------
url <- "https://raw.githubusercontent.com/gregoiredavid/france-geojson/master/departements.geojson"
download.file(url, "departements.geojson", mode = "wb", quiet = TRUE)
# Charger directement en sf
departements <- st_read("departements.geojson", quiet = TRUE)
# ------------------------------------------------------------
# 2. FUSIONNER AVEC VOS DONNÉES D'ACCIDENTS
# ------------------------------------------------------------
# table_frequence doit avoir : dep, nb_accidents
departements_data <- departements %>%
left_join(table_frequence, by = c("code" = "dep"))
# ------------------------------------------------------------
# 3. CALCULER LES CENTROÏDES
# ------------------------------------------------------------
centroids <- st_centroid(departements_data) %>%
st_coordinates() %>%
as.data.frame() %>%
bind_cols(dep = departements_data$code,
nb_accidents = departements_data$nb_accidents) %>%
filter(!is.na(nb_accidents))
# ------------------------------------------------------------
# 4. CRÉER LA CARTE
# ------------------------------------------------------------
carte <- ggplot() +
# Fond de carte
geom_sf(data = departements_data, fill = "#f7f7f7", color = "white", size = 0.4, alpha = 0.9) +
# Points proportionnels
geom_point(
data = centroids,
aes(x = X, y = Y, size = nb_accidents),
color = "#e41a1c",
fill = "#ff9999",
alpha = 0.7,
shape = 21,
stroke = 1
) +
# Étiquettes
geom_text(
data = centroids %>% filter(nb_accidents > quantile(nb_accidents, 0.75)),
aes(x = X, y = Y, label = dep),
size = 2.5,
color = "black",
fontface = "bold",
vjust = -1.2
) +
# Échelles
scale_size_continuous(
name = "Nombre d'accidents",
range = c(3, 20),
breaks = quantile(centroids$nb_accidents, probs = c(0.25, 0.5, 0.75, 1)),
labels = function(x) format(round(x), big.mark = " ")
) +
labs(
title = "CARTE DES ACCIDENTS ROUTIERS PAR DÉPARTEMENT",
subtitle = "Année 2019 - Les cercles sont proportionnels au nombre d'accidents",
caption = "Source: ONISR | Données: fichier BAAC 2019"
) +
theme_minimal(base_size = 12) +
theme(
axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank(),
plot.title = element_text(hjust = 0.5, face = "bold", size = 16, margin = margin(b = 10)),
plot.subtitle = element_text(hjust = 0.5, size = 12, color = "gray40", margin = margin(b = 15)),
plot.caption = element_text(hjust = 0.5, size = 9, color = "gray50", margin = margin(t = 15)),
legend.position = "right"
) +
coord_sf(xlim = c(-5, 10), ylim = c(41, 52))
# ------------------------------------------------------------
# 5. AFFICHER ET SAUVEGARDER
# ------------------------------------------------------------
print(carte)
ggsave("carte_accidents_departements.png", plot = carte, width = 12, height = 10, dpi = 300, bg = "white")
# ------------------------------------------------------------
# INSTALLATION
# ------------------------------------------------------------
# install.packages("ggplot2")
# install.packages("sf")          # indispensable maintenant
# install.packages("dplyr")
# install.packages("viridis")
# ------------------------------------------------------------
# CHARGEMENT DES LIBRAIRIES
# ------------------------------------------------------------
library(ggplot2)
library(dplyr)
library(sf)
library(viridis)
# ------------------------------------------------------------
# 1. TÉLÉCHARGER ET PRÉPARER LES DONNÉES GÉOGRAPHIQUES
# ------------------------------------------------------------
url <- "https://raw.githubusercontent.com/gregoiredavid/france-geojson/master/departements.geojson"
download.file(url, "departements.geojson", mode = "wb", quiet = TRUE)
# Charger directement en sf
departements <- st_read("departements.geojson", quiet = TRUE)
# ------------------------------------------------------------
# 2. FUSIONNER AVEC VOS DONNÉES D'ACCIDENTS
# ------------------------------------------------------------
# table_frequence doit avoir : dep, nb_accidents
departements_data <- departements %>%
left_join(table_frequence, by = c("code" = "dep"))
# ------------------------------------------------------------
# 3. CALCULER LES CENTROÏDES
# ------------------------------------------------------------
centroids <- st_centroid(departements_data) %>%
st_coordinates() %>%
as.data.frame() %>%
bind_cols(dep = departements_data$code,
nb_accidents = departements_data$nb_accidents) %>%
filter(!is.na(nb_accidents))
# ------------------------------------------------------------
# 4. CRÉER LA CARTE
# ------------------------------------------------------------
carte <- ggplot() +
# Fond de carte
geom_sf(data = departements_data, fill = "#f7f7f7", color = "white", size = 0.4, alpha = 0.9) +
# Points proportionnels
geom_point(
data = centroids,
aes(x = X, y = Y, size = nb_accidents),
color = "#e41a1c",
fill = "#ff9999",
alpha = 0.7,
shape = 21,
stroke = 1
) +
# Étiquettes
geom_text(
data = centroids %>% filter(nb_accidents > quantile(nb_accidents, 0.75)),
aes(x = X, y = Y, label = dep),
size = 2.5,
color = "black",
fontface = "bold",
vjust = -1.2
) +
# Échelles
scale_size_continuous(
name = "Nombre d'accidents",
range = c(3, 20),
breaks = quantile(centroids$nb_accidents, probs = c(0.25, 0.5, 0.75, 1)),
labels = function(x) format(round(x), big.mark = " ")
) +
labs(
title = "CARTE DES ACCIDENTS ROUTIERS PAR DÉPARTEMENT",
subtitle = "Année 2019 - Les cercles sont proportionnels au nombre d'accidents",
caption = "Source: ONISR | Données: fichier BAAC 2019"
) +
theme_minimal(base_size = 12) +
theme(
axis.text = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
panel.grid = element_blank(),
plot.title = element_text(hjust = 0.5, face = "bold", size = 16, margin = margin(b = 10)),
plot.subtitle = element_text(hjust = 0.5, size = 12, color = "black", margin = margin(b = 15)),
plot.caption = element_text(hjust = 0.5, size = 9, color = "gray50", margin = margin(t = 15)),
legend.position = "right"
) +
coord_sf(xlim = c(-5, 10), ylim = c(41, 52))
# ------------------------------------------------------------
# 5. AFFICHER ET SAUVEGARDER
# ------------------------------------------------------------
print(carte)
ggsave("carte_accidents_departements.png", plot = carte, width = 12, height = 10, dpi = 300, bg = "white")
# ============================================================
# Comparaison observé / théorique
# pour la luminosité (lum2) et l’atmosphère (atm3)
# ============================================================
# =========================
# 1. Librairies
# =========================
library(dplyr)
library(tidyr)
library(ggplot2)
# =========================
# 2. Prédictions du modèle
# =========================
df <- df %>%
mutate(S_pred = predict(mod_final, newdata = df))
# =========================
# 3. Luminosité (lum2)
# =========================
df_lum2 <- df %>%
filter(!is.na(lum2)) %>%
group_by(modalite = lum2) %>%
summarise(
severite_observee  = mean(S_sevérité, na.rm = TRUE),
severite_theorique = mean(S_pred,     na.rm = TRUE),
n = n(),
.groups = "drop"
) %>%
mutate(variable = "Luminosité")
# =========================
# 4. Atmosphère (atm3)
# =========================
df_atm3 <- df %>%
filter(!is.na(atm3)) %>%
group_by(modalite = atm3) %>%
summarise(
severite_observee  = mean(S_sevérité, na.rm = TRUE),
severite_theorique = mean(S_pred,     na.rm = TRUE),
n = n(),
.groups = "drop"
) %>%
mutate(variable = "Atmosphère")
# =========================
# 5. Fusion + format long
# =========================
df_compare <- bind_rows(df_lum2, df_atm3) %>%
pivot_longer(
cols = c(severite_observee, severite_theorique),
names_to = "type",
values_to = "severite"
) %>%
mutate(
type = recode(
type,
severite_observee  = "Sévérité observée",
severite_theorique = "Sévérité théorique"
)
)
# =========================
# 6. Graphe final
# =========================
ggplot(df_compare,
aes(x = modalite, y = severite, fill = type)) +
geom_col(position = "dodge", width = 0.7) +
facet_wrap(~ variable, scales = "free_x") +
labs(
title = "Comparaison des sévérités observée et théorique\nselon la luminosité et l’atmosphère",
x = "Modalité",
y = "Score de sévérité"
) +
theme_minimal() +
theme(
axis.text.x  = element_text(angle = 45, hjust = 1),
legend.title = element_blank(),
strip.text   = element_text(face = "bold")
)
